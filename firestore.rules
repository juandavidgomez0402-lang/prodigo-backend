rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function manages(storeId) {
      return signedIn() && (
        (request.auth.token.role == storeId && request.auth.token.storeId == storeId)
        || exists(/databases/$(database)/documents/stores/$(storeId)/admins/$(request.auth.uid))
      );
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if manages(storeId);

      match /products/{productId} {
        allow read: if true;
        allow write: if manages(storeId);
      }

      match /admins/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}
